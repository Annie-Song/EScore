# 复制本文件为 .env 并填入你的 DeepSeek API Key
# DeepSeek 控制台: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Flask 调试模式（生产环境保持 0）
FLASK_DEBUG=0

# HuggingFace 模型下载端点：国内访问 huggingface.co 超时，设为镜像
HF_ENDPOINT=https://hf-mirror.com

# 向量嵌入微服务地址：默认 http://127.0.0.1:8765，独立进程部署时改指向服务主机
EMBEDDING_SERVICE_URL=http://127.0.0.1:8765

# OCR 微服务地址：默认 http://127.0.0.1:8766，独立进程部署时改指向服务主机
OCR_SERVICE_URL=http://127.0.0.1:8766

# 微服务监听地址覆盖（容器/独立进程部署用；本地开发保持 127.0.0.1）：
# 容器内须绑 0.0.0.0 才能被其他容器访问，docker-compose.yml 已显式设置
FLASK_HOST=127.0.0.1
EMBEDDING_SERVICE_HOST=127.0.0.1
OCR_SERVICE_HOST=127.0.0.1

# Flask 会话签名密钥（生产必改）
SECRET_KEY=your_secret_key_here

# 支付宝沙箱网关（可选）：均为沙箱占位，不填则支付流程走本地演示网关（可直接完成升级）
# 沙箱应用 AppID（开放平台沙箱环境创建应用后获取）
ALIPAY_APP_ID=
# 应用私钥（2048 RSA2，PKCS1，以 -----BEGIN RSA PRIVATE KEY----- 开头）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（沙箱环境开放平台密钥工具获取，非应用公钥）
ALIPAY_PUBLIC_KEY=
# 沙箱网关地址（默认已指向沙箱，生产环境改正式网关）
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 支付同步/异步回调地址（生产用公网 HTTPS 地址覆盖）
PAY_RETURN_URL=http://127.0.0.1:5000/api/pay/return
PAY_NOTIFY_URL=http://127.0.0.1:5000/api/pay/notify
