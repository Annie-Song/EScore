# 复制本文件为 .env 并填入你的 DeepSeek API Key
# DeepSeek 控制台: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Flask 调试模式（生产环境保持 0）
FLASK_DEBUG=0

# HuggingFace 模型下载端点：国内访问 huggingface.co 超时，设为镜像
HF_ENDPOINT=https://hf-mirror.com

# 向量嵌入微服务地址：默认 http://127.0.0.1:8765，独立进程部署时改指向服务主机
EMBEDDING_SERVICE_URL=http://127.0.0.1:8765

# OCR 微服务地址：默认 http://127.0.0.1:8766，独立进程部署时改指向服务主机
OCR_SERVICE_URL=http://127.0.0.1:8766
