# 忽略操作系统生成的文件
.DS_Store          # macOS
Thumbs.db          # Windows
desktop.ini        # Windows

# 忽略日志文件
*.log

# 忽略临时文件
*.tmp
*.swp
*.bak
*.old

# 忽略编译生成的文件
*.out
*.class
*.o
*.so
*.dll
*.exe

# 忽略Node.js项目中的node_modules目录
node_modules/

# 忽略Python项目中的虚拟环境目录
venv/
__pycache__/
*.pyc

# 忽略Java项目中的编译目录
target/
build/

# 忽略IDE生成的文件
.idea/
.vscode/

# 数据文件
data/

# 依赖文件
env/

# 环境变量（含密钥，不入库）
.env
.env.*
!.env.example

# 忽略log文件
log/

Scripts

Libs

add

# 运行时目录（用户上传与生成结果）
uploads/

# 运行时生成的批改报告与增强图（output/ 下已有实验 csv 需保留跟踪）
output/reports/
output/enhance/
output/segments/

# 批改记录数据库及其 WAL/SHM 文件
output/*.db*

# 超分模型权重（大文件，官方云盘/Releases 下载，不入库）
ESRGAN/models/*.pth

# 忽略个人文档与工作记忆
DOCX/
memory/